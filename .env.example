# ─────────────────────────────────────────────────────────────
# iConnect Pre-Owned — environment variables
# Copy this file to .env.local and fill in real values.
# Nothing in this repo will hit a live database or payment
# provider until these are set — see README.md "What's wired
# vs. what's mocked".
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=27712345678

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — international customers only, see README
# (South African-registered businesses cannot receive payouts
# directly on Stripe — use PayFast below as the primary gateway)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PayFast — recommended primary gateway for South African payouts
# https://www.payfast.co.za
NEXT_PUBLIC_PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
NEXT_PUBLIC_PAYFAST_MODE=sandbox

# Cloudinary — Dashboard → Account details
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Resend (transactional email) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=orders@iconnectpreowned.co.za
